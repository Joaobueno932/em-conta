{
  "name": "em-conta-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build",
    "lint": "oxlint . && eslint . --cache",
    "lint:fix": "oxlint . --fix && eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/ e2e/ scripts/",
    "format:check": "prettier --check --experimental-cli src/ e2e/ scripts/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "contract:update": "node scripts/update-contract.mjs",
    "verify": "npm run lint && npm run format:check && npm run type-check && npm run test && npm run build-only"
  },
  "dependencies": {
    "@tanstack/vue-query": "5.105.0",
    "pinia": "4.1.0",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/vue": "8.1.0",
    "@tsconfig/node24": "24.0.5",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/eslint-plugin": "1.6.28",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-oxlint": "1.82.0",
    "eslint-plugin-playwright": "2.12.1",
    "eslint-plugin-vue": "10.11.1",
    "jiti": "2.7.0",
    "jsdom": "30.1.3",
    "npm-run-all2": "9.0.4",
    "oxlint": "1.82.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vite-plugin-vue-devtools": "8.2.1",
    "vitest": "4.1.11",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.13"
  },
  "engines": {
    "node": ">=24.12.0 <25",
    "npm": ">=11.17.0"
  },
  "packageManager": "npm@11.17.0",
  "description": "Frontend do Em Conta (Vue 3 + TypeScript)"
}
