# Copie para .env (ignorado pelo Git) e ajuste. Valores abaixo são EXEMPLOS para uso local,
# não segredos reais. Nunca reutilize estas senhas fora da máquina de desenvolvimento.

# MySQL — DB_* também são lidas pelo backend (profile local usa os mesmos padrões).
MYSQL_ROOT_PASSWORD=troque_root_local
DB_NAME=emconta
DB_USERNAME=emconta
DB_PASSWORD=emconta_local_dev
# 3310 evita conflito com instalações locais de MySQL (3306) e outros projetos (3307).
MYSQL_PORT=3310

# RabbitMQ (preparação; o backend ainda não consome filas)
RABBITMQ_USER=emconta
RABBITMQ_PASSWORD=troque_rabbit_local
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

# MinIO (preparação; armazenamento de documentos ainda não implementado)
MINIO_ROOT_USER=emconta
MINIO_ROOT_PASSWORD=troque_minio_local
MINIO_BUCKET=emconta-local
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Mailpit (captura os e-mails de convite e de recuperação no ambiente local)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Backend (opcional no local: o profile local já usa estes valores). Fora do local, configure
# EMCONTA_URL_PUBLICA com https e um SMTP real; as credenciais SMTP nunca vão para o repositório.
# EMCONTA_URL_PUBLICA=http://localhost:5173
# EMCONTA_EMAIL_REMETENTE=Em Conta <nao-responda@localhost>
# SPRING_MAIL_HOST=localhost
# SPRING_MAIL_PORT=1025

# WhatsApp Cloud API (integração direta com a Meta). Deixe em branco até receber o acesso: a aplicação
# mostra "Canal não configurado" e não envia nada. Preencha só no .env local (ignorado pelo Git) ou no
# cofre de segredos do ambiente; nunca no repositório. Não use o número oficial operado pelo GDASH.
# WHATSAPP_ACCESS_TOKEN=        token de acesso do sistema (envio de mensagens)
# WHATSAPP_PHONE_NUMBER_ID=     Phone Number ID do número de teste/homologação
# WHATSAPP_APP_SECRET=          App Secret do app Meta (valida X-Hub-Signature-256 do webhook)
# WHATSAPP_VERIFY_TOKEN=        token escolhido para a verificação inicial do webhook (outro segredo)
# WHATSAPP_GRAPH_VERSION=v23.0  versão da Graph API
# Webhook a cadastrar no app Meta (exige URL pública HTTPS): https://<host>/api/v1/integracoes/whatsapp/webhook
